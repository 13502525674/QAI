<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ape.apesystem.mapper.QuestionKnowledgeMapper">

    <resultMap id="QuestionKnowledgeResult" type="com.ape.apesystem.domain.QuestionKnowledge">
        <id property="id" column="id"/>
        <result property="questionId" column="question_id"/>
        <result property="questionType" column="question_type"/>
        <result property="kpId" column="kp_id"/>
        <result property="weight" column="weight"/>
        <result property="createTime" column="create_time"/>
        <result property="kpName" column="kp_name"/>
    </resultMap>

    <select id="selectByQuestionId" resultMap="QuestionKnowledgeResult">
        SELECT qk.*, kp.name as kp_name
        FROM question_knowledge qk
        LEFT JOIN knowledge_point kp ON qk.kp_id = kp.id
        WHERE qk.question_id = #{questionId}
    </select>

    <select id="selectByKpId" resultMap="QuestionKnowledgeResult">
        SELECT qk.*, kp.name as kp_name
        FROM question_knowledge qk
        LEFT JOIN knowledge_point kp ON qk.kp_id = kp.id
        WHERE qk.kp_id = #{kpId}
    </select>

    <delete id="deleteByQuestionId">
        DELETE FROM question_knowledge WHERE question_id = #{questionId}
    </delete>

</mapper>
