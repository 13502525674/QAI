# ============================================================
# 物理学术研究交流平台 — 环境变量
# ============================================================

# --- 百炼 API Key (统一使用 deepseek-v4-flash) ---
# 从电脑环境变量 aliQwen-api 读取，此处可覆盖
DASHSCOPE_API_KEY=

# --- DeepSeek-V4-Flash (通过百炼 OpenAI 兼容接口) ---
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=deepseek-v4-flash

# --- Redis (与 Java 端共用) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Chroma 向量库 ---
CHROMA_PERSIST_DIR=./chroma_data

# --- LangSmith (可选调试) ---
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=

# --- 服务 ---
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
DEBUG=true